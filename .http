  "code": "568277"
}

### 6. Code faux → 400
POST {{baseUrl}}/auth/confirm
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "code": "000000"
}

### ---------- CONNEXION ----------

### 7. Connexion → 200 + token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "password": "motdepasse123"
}

### 8. Mauvais mot de passe → 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "password": "mauvais123"
}

### ---------- ROUTE PROTÉGÉE ----------

### 9. Profil avec token → 200
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 10. Sans token → 401
GET {{baseUrl}}/auth/me

### 11. Faux token → 401
GET {{baseUrl}}/auth/me
Authorization: Bearer nimportequoi

### ---------- MOT DE PASSE OUBLIÉ ----------

### 12. Mot de passe oublié → 204 + code reset dans les logs
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json

{
  "email": "lucas@test.fr"
}

### 13. Email inconnu → 204, aucun code dans les logs
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json

{
  "email": "inconnu@test.fr"
}

### 14. Reset avec le code des logs → 204
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "code": "559844",
  "new_password": "nouveaumdp123"
}

### 15. Login ancien mot de passe → 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "password": "motdepasse123"
}

