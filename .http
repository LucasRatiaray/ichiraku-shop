@token = bf18a1d4d9b51c123558bf6c25042314469ae1e1d2d31654d649ada08de906ab

### 0. Health → 200
GET {{baseUrl}}/health

### ---------- INSCRIPTION ----------

### 1. Inscription valide → 201
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "password": "motdepasse123"
}

### 2. Même email → 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "password": "motdepasse123"
}

### 3. Mot de passe trop court → 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "autre@test.fr",
  "password": "abc"
}

### 4. JSON invalide → 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "casse@test.fr",}

### ---------- CONFIRMATION ----------

### 5. Confirmation avec le code des logs → 204
POST {{baseUrl}}/auth/confirm
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "code": "568277"
}

### 6. Code faux → 400
POST {{baseUrl}}/auth/confirm
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "code": "000000"
}

### ---------- CONNEXION ----------

### 7. Connexion → 200 + token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "password": "motdepasse123"
}

### 8. Mauvais mot de passe → 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "password": "mauvais123"
}

### ---------- ROUTE PROTÉGÉE ----------

### 9. Profil avec token → 200
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 10. Sans token → 401
GET {{baseUrl}}/auth/me

### 11. Faux token → 401
GET {{baseUrl}}/auth/me
Authorization: Bearer nimportequoi

### ---------- MOT DE PASSE OUBLIÉ ----------

### 12. Mot de passe oublié → 204 + code reset dans les logs
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json

{
  "email": "lucas@test.fr"
}

### 13. Email inconnu → 204, aucun code dans les logs
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json

{
  "email": "inconnu@test.fr"
}

### 14. Reset avec le code des logs → 204
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "code": "559844",
  "new_password": "nouveaumdp123"
}

### 15. Login ancien mot de passe → 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "password": "motdepasse123"
}

### 16. Login nouveau mot de passe → 200 + token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "lucas@test.fr",
  "password": "nouveaumdp123"
}

### ---------- DÉCONNEXION ----------

### 17. Logout → 204
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

### 18. Me avec le token déconnecté → 401
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

